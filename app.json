{
  "expo": {
    "name": "SKILL'Z",
    "slug": "skillz-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "skillz",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1217"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillz.app",
      "associatedDomains": ["applinks:skillz.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "SKILL'Z utilise la caméra pour analyser tes mouvements pendant les défis physiques et valider automatiquement tes performances.",
        "NSMicrophoneUsageDescription": "SKILL'Z utilise le microphone pour synchroniser les défis.",
        "NSMotionUsageDescription": "SKILL'Z utilise les capteurs pour détecter tes mouvements.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SKILL'Z suit ta course.",
        "NSLocationWhenInUseUsageDescription": "SKILL'Z mesure ta distance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1217"
      },
      "package": "com.skillz.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "skillz.app", "pathPrefix": "/defi" },
            { "scheme": "skillz" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SKILL'Z utilise la caméra pour valider tes défis physiques en analysant tes mouvements."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SKILL'Z a besoin de ta position pour mesurer tes courses.",
          "locationAlwaysPermission": "SKILL'Z suit ta course en arrière-plan.",
          "locationWhenInUsePermission": "SKILL'Z utilise ta position pour mesurer la distance."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07329084-6e89-4410-b2fa-a7e13d4f4184"
      }
    },
    "owner": "braelblack"
  }
}